# net.core.somaxconn: Listen backlog cap — https://docs.kernel.org/networking/ip-sysctl.html
net.core.somaxconn = 4096

# net.ipv4.tcp_rmem: TCP receive buffer — https://docs.kernel.org/networking/ip-sysctl.html
net.ipv4.tcp_rmem = 4096 131072 16777216
