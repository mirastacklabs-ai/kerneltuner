# Generated by kerneltuner v0.0.0-test on 2026-11-16
# Review before applying: these are recommendations, not verified for your workload.
# Install as /etc/tuned/kerneltuner/tuned.conf, then: tuned-adm profile kerneltuner

[main]
include=network-throughput

[sysctl]
# net.core.somaxconn: Listen backlog cap — https://docs.kernel.org/networking/ip-sysctl.html
net.core.somaxconn=4096
# net.ipv4.tcp_rmem: TCP receive buffer — https://docs.kernel.org/networking/ip-sysctl.html
net.ipv4.tcp_rmem=4096 131072 16777216

[sysfs]
# storage.scheduler: NVMe scheduler — https://docs.kernel.org/networking/ip-sysctl.html
/sys/block/nvme0n1/queue/scheduler=none

[bootloader]
# REBOOT REQUIRED
cmdline=+iommu=pt nohz_full
